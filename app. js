let balance = 0;

function addIncome() {
  const amount = Number(document.getElementById("amount").value);
  balance += amount;
  update();
}

function addExpense() {
  const amount = Number(document.getElementById("amount").value);
  balance -= amount;
  update();
}

function update() {
  document.getElementById("balance").innerText = "Balance: " + balance;
}
